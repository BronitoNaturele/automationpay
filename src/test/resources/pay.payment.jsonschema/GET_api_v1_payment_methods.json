{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
    "data": {
    "type": "array",
    "minItems": 1,
    "items": {
    "type": "object",
    "properties": {
    "name": {
    "type": "string",
    "minLength": 1
},
    "uuid": {
    "type": "string"
},
    "type_id": {
    "type": "integer",
    "minimum": 0
},
    "weight": {
    "type": "integer",
    "minimum": 0
}
},
    "required": ["name", "uuid", "type_id", "weight"],
    "additionalProperties": false
}
}
},
    "required": ["data"],
    "additionalProperties": false
}